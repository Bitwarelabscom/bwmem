{
  "name": "@bitwarelabs/bwmem",
  "version": "0.9.5",
  "description": "Memory SDK for AI chatbots - bi-temporal facts, cross-key collision detection, same-claim merge gates, semantic search, contradiction detection with a real open/held/resolved lifecycle, quality scoring, session texture, self-intentions, multi-stage consolidation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./graph": {
      "import": "./dist/graph/index.js",
      "types": "./dist/graph/index.d.ts"
    },
    "./providers/openai": {
      "import": "./dist/providers/openai.js",
      "types": "./dist/providers/openai.d.ts"
    },
    "./providers/ollama": {
      "import": "./dist/providers/ollama.js",
      "types": "./dist/providers/ollama.d.ts"
    },
    "./providers/openrouter": {
      "import": "./dist/providers/openrouter.js",
      "types": "./dist/providers/openrouter.d.ts"
    }
  },
  "files": [
    "dist",
    "src/db/migrations"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "start:api": "node dist/api/server.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "memory",
    "ai",
    "chatbot",
    "embeddings",
    "semantic-search",
    "facts",
    "pgvector",
    "bi-temporal",
    "contradiction-detection",
    "quality-scoring",
    "session-texture",
    "consolidation"
  ],
  "author": "Henrik Robertsson <henke@bitwarelabs.com> (https://bitwarelabs.com/)",
  "license": "AGPL-3.0-only",
  "homepage": "https://bitwarelabs.com/bwmem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitwarelabscom/bwmem.git"
  },
  "bugs": {
    "url": "https://github.com/Bitwarelabscom/bwmem/issues",
    "email": "henke@bitwarelabs.com"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "bullmq": "^5.81.3",
    "fastify": "^5.12.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "neo4j-driver": "^6.2.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "neo4j-driver": "^5 || ^6",
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "neo4j-driver": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
